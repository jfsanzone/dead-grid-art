{
 "version": "anim-v1",
 "scale": {
  "at2x": "2 px per world px for every sheet (heroes, Coupler, zombies). 1x = 1 px per world px.",
  "zombies": "zombies were rescaled from the ~4.1 px/world grounding-v1 PNGs so the visible height matches the grounding rule ((PNG h - 16) = world height: drifter 62.5, sprinter 60, howler 63.75, bulwark 72.5). Draw the zombie sheets at cell size like the heroes (no extra scale).",
  "heroes": "same scale, outline and foot point as grounding-v1 / hero-sprites-v2."
 },
 "footPoint": "pivot = foot point (between the feet on the ground), bottom-centre anchor. Position the sprite so the pivot sits on the unit world position.",
 "directions": {
  "order": [
   "down",
   "up",
   "left",
   "right",
   "downleft",
   "downright",
   "upleft",
   "upright"
  ],
  "pick": "8-way from the movement vector on screen: right 0deg, downright 45, down 90, ... (+y down), sectors of 45 deg"
 },
 "speedMapping": {
  "rule": "feet lock to the ground only when fps = speed * framesPerCycle / worldPxPerCycle. worldPxPerCycle is the same in all 8 directions (stride is constant on screen), so scale the walk fps with the unit move speed (or set move speed from the fps given here).",
